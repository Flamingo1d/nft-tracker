name: Weekly NFT Scan

on:
  schedule:
    # 03:00 UTC Mondays — deliberately early. Scheduled Actions get delayed
    # under load, and the reader downstream needs the data to be there already.
    - cron: '0 3 * * 1'
  workflow_dispatch:
    inputs:
      mode:
        description: 'Run mode'
        type: choice
        options: [scan, probe, dry-run]
        default: scan

jobs:
  scan:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-python@v6
        with:
          python-version: '3.12'

      - run: pip install -r requirements.txt

      - name: Run scan
        env:
          OPENSEA_API_KEY: ${{ secrets.OPENSEA_API_KEY }}
        run: |
          case "${{ inputs.mode }}" in
            probe)   python scan.py --probe ;;
            dry-run) python scan.py --dry-run ;;
            *)       python scan.py ;;
          esac

      - name: Summary
        if: always()
        run: |
          {
            echo '## Scan '"$(date -u +%Y-%m-%d)"
            echo '```'
            python - <<'PY' 2>/dev/null || echo "no scan data"
          import json
          d = json.load(open('latest-scan.json'))
          print(f"measured {d['measured']} | qualifying {len(d['qualifying'])} | near misses {len(d['near_misses'])}")
          for r in d['qualifying']:
              print(f"  PASS {r['slug']} floor={r.get('floor_eth')} spread={r.get('spread_pct')}%")
          for e in d.get('events', []):
              print(f"  {e['type'].upper()} {e['slug']}")
          PY
            echo '```'
          } >> $GITHUB_STEP_SUMMARY

      - name: Upload artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: scan-output
          path: |
            latest-scan.json
            watchlist.json
            history.json
          if-no-files-found: warn
          retention-days: 90

      - name: Commit
        if: always()
        run: |
          git config user.name  "nft-scanner"
          git config user.email "actions@github.com"
          for f in latest-scan.json watchlist.json history.json; do
            [ -f "$f" ] && git add "$f" && echo "staged $f"
          done
          if git diff --staged --quiet; then
            echo "nothing to commit"
          else
            git commit -m "Scan $(date -u +%Y-%m-%d)"
            git pull --rebase --autostash origin "${GITHUB_REF_NAME}" || true
            git push
          fi
